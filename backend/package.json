{
  "name": "allowance-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Allowance API: purchase pipeline, policy engine, PayPal integration, AI agent, MCP server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "check-ai": "tsx scripts/check-ai.ts",
    "mcp": "tsx mcp/server.ts",
    "mcp:demo": "tsx scripts/mcp-demo.ts",
    "external-buy": "tsx scripts/external-buy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
