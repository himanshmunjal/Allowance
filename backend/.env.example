# ─────────────────────────────────────────────────────────────────────────────
# Allowance backend: environment variables. Copy to .env and fill in.
#   cp .env.example .env
# (The frontend has its own small file: frontend/.env.example)
# ─────────────────────────────────────────────────────────────────────────────

# Port the API listens on.
PORT=4000

# Public URL of the FRONTEND (no trailing slash). PayPal redirects back there after
# the wallet-connect approval, and approval links point there.
#   local:  http://localhost:3000
#   Render: https://<your-frontend>.onrender.com
APP_URL=http://localhost:3000

# ── PayPal (sandbox) ─────────────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → (Sandbox) → your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave as-is for sandbox.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: only needed if the app is on a public URL and you created a webhook
# (Apps & Credentials → your app → Webhooks → Add webhook → <backend URL>/api/paypal/webhook).
PAYPAL_WEBHOOK_ID=

# ── AI providers ─────────────────────────────────────────────────────────────
# You need at least ONE key. Gemini and Groq both have FREE tiers (no card).
# If the first provider is rate-limited or down, the next one answers automatically.
# Test your keys with:  npm run check-ai

# Gemini (free): https://aistudio.google.com/apikey  → "Create API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (free): https://console.groq.com/keys  → "Create API Key"
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claude (paid, optional): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Which provider to try first (gemini | groq | anthropic). Empty = first one with a key,
# in the order gemini, groq, anthropic.
LLM_PROVIDER=gemini
# Fallback order, comma-separated. Empty = every other provider that has a key.
LLM_FALLBACKS=

# AI risk check: "autopay" (default) runs it only when a purchase would be paid
# automatically (saves free-tier quota); "always" also checks purchases you approve yourself.
RISK_CHECK=autopay

# ── Product catalog ──────────────────────────────────────────────────────────
# Live products from Channel3 (https://channel3.ai, a hackathon sponsor): get a key from
# their dashboard. Empty = use the built-in demo catalog. If Channel3 fails (bad key,
# credits used up, timeout) or finds nothing, search falls back to the demo catalog.
CHANNEL3_API_KEY=
# "channel3" (default) or "demo" (force the demo catalog, e.g. to record the safety demos).
CATALOG_SOURCE=channel3

# ── External agents (MCP) ────────────────────────────────────────────────────
# Each agent now has its OWN key, created in the dashboard (Agents tab → New agent).
# AGENT_API_KEY here is the key the local MCP server / npm scripts act as. If it is set
# before the first account is created, that account gets it as its first agent automatically.
# Generate one with:  openssl rand -hex 24
AGENT_API_KEY=

# ── External stores (checkout quotes) ────────────────────────────────────────
# Key an external website uses to create checkout quotes (item + price) that an agent
# can then pay for. Separate from AGENT_API_KEY: the agent must never set a price.
# Generate one with:  openssl rand -hex 24
MERCHANT_API_KEY=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Create the database once:  createdb -U postgres allowance   (or in psql: CREATE DATABASE allowance;)
# Tables are created automatically on startup.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/allowance
