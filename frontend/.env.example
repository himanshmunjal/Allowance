# ─────────────────────────────────────────────────────────────────────────────
# Allowance frontend: copy to .env.local and fill in.
#   cp .env.example .env.local
# (Secrets live in backend/.env. Nothing here is secret.)
# ─────────────────────────────────────────────────────────────────────────────

# Where the backend API runs. The frontend proxies /api/* to it.
#   local:  http://localhost:4000
#   Render: https://<your-backend>.onrender.com
BACKEND_URL=http://localhost:4000

# PayPal sandbox Client ID (same value as PAYPAL_CLIENT_ID in backend/.env).
# Public by design: the browser needs it to load the PayPal button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
